```{=html}
<%
const gruplar = [
  ["yurutucu", "yürütücü", ""],
  ["arastirmaci", "araştırmacılar", ""],
  ["danisman", "danışmanlar", ""],
  ["bursiyer", "bursiyerler", "Doktora, yüksek lisans ve lisans bursiyerleri belirlendiğinde burada yer alacaktır."]
];
const basHarf = (ad) => ad.replace(/(Prof\.|Doç\.|Dr\.|Araş\.|Arş\.|Gör\.)/g, "").trim().split(/\s+/).map(s => s[0]).slice(0, 2).join("");
const sirali = [...items].sort((a, b) => (a.sira ?? 99) - (b.sira ?? 99));
%>
<% for (const [rol, baslik, bosMesaj] of gruplar) { const uyeler = sirali.filter(i => i.rol === rol); %>
<section class="recep-people-group">
<h2 class="anchored" id="<%- rol %>"><%= baslik %></h2>
<% if (!uyeler.length) { %><div class="recep-bos"><%= bosMesaj || "Henüz kayıt yok." %></div><% continue; } %>
<div class="recep-people">
<% for (const k of uyeler) { %>
<article class="recep-person">
<% if (k.foto) { %><img class="recep-avatar" src="<%- k.foto %>" alt="<%= k.ad %>" loading="lazy" width="64" height="64"><% } else { %><div class="recep-avatar" aria-hidden="true"><%= basHarf(k.ad) %></div><% } %>
<div class="recep-person-body">
<div class="recep-person-name"><%= k.ad %></div>
<div class="recep-person-role"><%= k.unvan %><% if (k.kurum) { %> · <%= k.kurum %><% } %></div>
<% if (k.alan) { %><div class="recep-person-area"><%= k.alan %></div><% } %>
<div class="recep-person-links">
<% if (k.eposta) { %><a href="mailto:<%- k.eposta %>" aria-label="E-posta"><i class="bi bi-envelope"></i></a><% } %>
<% if (k.web) { %><a href="<%- k.web %>" aria-label="Web"><i class="bi bi-globe2"></i></a><% } %>
<% if (k.scholar) { %><a href="<%- k.scholar %>" aria-label="Google Scholar"><i class="bi bi-mortarboard"></i></a><% } %>
<% if (k.github) { %><a href="https://github.com/<%- k.github %>" aria-label="GitHub"><i class="bi bi-github"></i></a><% } %>
<% if (k.orcid) { %><a href="https://orcid.org/<%- k.orcid %>" class="recep-tag">orcid</a><% } %>
</div>
</div>
</article>
<% } %>
</div>
</section>
<% } %>
```
